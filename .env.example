# Copy to .env and fill in. Used by both docker-compose.yml and docker-compose.prod.yml.

# Required: master key that decrypts config/credentials.yml.enc.
# On an existing install this lives in config/master.key.
# If you do not have one, see the README's "Configure the credentials file" section.
RAILS_MASTER_KEY=

# MariaDB credentials. The DATABASE_* vars are read by config/database.yml,
# the MARIADB_* vars seed the mariadb container's initial database + user.
MARIADB_ROOT_PASSWORD=changeme
DATABASE_USERNAME=ffxiv
DATABASE_PASSWORD=changeme

# Host paths for runtime data and credentials, mounted into the containers.
# Both must be set — Compose has no fallback. Use forward slashes even on
# Windows. The directories (and their subdirs xiv-data/, log/, tmp/, etc.)
# are auto-created on first `up`.
#   ASSETS_DIR holds the database mounts, downloaded images, logs and the
#     xiv-data checkout. Survives image rebuilds.
#   CONFIG_DIR holds credentials.yml.enc (mounted read-only into the container).
ASSETS_DIR=/absolute/path/to/deploy/assets
CONFIG_DIR=/absolute/path/to/deploy/config

# Defaults: ffxiv_collect_development for the dev compose file,
# ffxiv_collect_production for the prod compose file.
# Override here only if you want a custom DB name.
# DATABASE_NAME=ffxiv_collect_development

# Production-only: when fronting the app with an HTTPS-terminating reverse proxy,
# set this to 1 so force_ssl (config/environments/production.rb:47) plays nicely.
# Unset (or set to 0) when testing the prod image directly on http://localhost:3000.
# RAILS_ASSUME_SSL=1

# xiv-data is NOT baked into the image and does NOT need a submodule init on
# the host. The data-updater container clones github.com/skyborn-industries/xiv-data
# into ${ASSETS_DIR}/xiv-data on first `up` and pulls new commits on subsequent ups.

# What this stack does NOT include:
#   - The whenever-based cron container. Scheduled cache:* tasks (leaderboard
#     rankings, prices, ownership) will not refresh automatically — run them
#     manually with `docker compose run --rm web bin/rake cache:rankings:server`
#     etc., or schedule them on the host.
